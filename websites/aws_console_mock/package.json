{
  "name": "aws-console-mock",
  "private": true,
  "version": "1.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/emit-defaults.mjs && vite build",
    "preview": "vite preview",
    "gates": "node quality.contract.mjs",
    "fidelity": "node fidelity-score.mjs",
    "walk:vpc": "node walkthroughs/vpc-actions.mjs",
    "depth": "node depth-report.mjs",
    "walk:ec2": "node walkthroughs/ec2-actions.mjs",
    "walk:types": "node walkthroughs/instance-types.mjs",
    "walk:details": "node walkthroughs/detail-pages.mjs",
    "walk:vpcfam": "node walkthroughs/vpc-family.mjs",
    "walk": "for w in vpc-actions vpc-family ec2-actions instance-types ec2-preferences list-pages detail-pages; do node walkthroughs/$w.mjs || exit 1; done",
    "walk:prefs": "node walkthroughs/ec2-preferences.mjs",
    "defaults": "node scripts/emit-defaults.mjs",
    "gates:hardened": "CUA_GYM_HARDENED=1 CUA_GYM_ADMIN_TOKEN=$CUA_GYM_ADMIN_TOKEN node quality.contract.mjs --base ${BASE:-http://127.0.0.1:5399}",
    "walk:lists": "node walkthroughs/list-pages.mjs"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "puppeteer-core": "^25.8.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4"
  }
}
